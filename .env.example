# The voice. Point this at any Ollama instance.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty to auto-pick a model from /api/tags.
OLLAMA_MODEL=
# false = deterministic offline Archivist only.
LLM_ENABLED=true
LLM_TIMEOUT=300

# Optional OpenAI-compatible endpoint for an open-weight model.
# When both BASE and MODEL are set, this takes precedence over Ollama.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# Reading limits.
MAX_COMMITS=15000
MAX_SCANS=16
SCAN_TTL_SECONDS=21600
# Set false on a public deployment: it only reads public repositories.
ALLOW_LOCAL_PATHS=true
